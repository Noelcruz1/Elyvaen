<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Booming" parent="Base.Theme.Booming"/>

    <style name="Theme.Booming.Light" parent="Base.Theme.Booming.Light"/>

    <style name="Theme.Booming.Black" parent="Base.Theme.Booming.Black">
        <item name="colorPrimary">@color/elyvaen_primary</item>
        <item name="colorOnPrimary">@color/elyvaen_on_primary</item>
        <item name="colorPrimaryContainer">@color/elyvaen_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/elyvaen_on_primary_container</item>
        <item name="colorSecondary">@color/elyvaen_secondary</item>
        <item name="colorOnSecondary">@color/elyvaen_on_secondary</item>
        <item name="colorSecondaryContainer">@color/elyvaen_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/elyvaen_on_secondary_container</item>
        <item name="colorTertiary">@color/elyvaen_tertiary</item>
        <item name="colorOnTertiary">@color/elyvaen_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/elyvaen_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/elyvaen_on_tertiary_container</item>
        <item name="colorError">@color/elyvaen_error</item>
        <item name="colorOnError">@color/elyvaen_on_error</item>
        <item name="android:colorBackground">@color/elyvaen_background</item>
        <item name="colorOnBackground">@color/elyvaen_on_background</item>
        <item name="colorSurface">@color/elyvaen_surface</item>
        <item name="colorOnSurface">@color/elyvaen_on_surface</item>
        <item name="colorSurfaceVariant">@color/elyvaen_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/elyvaen_on_surface_variant</item>
        <item name="colorOutline">@color/elyvaen_outline</item>
        <item name="colorOutlineVariant">@color/elyvaen_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/elyvaen_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/elyvaen_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/elyvaen_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/elyvaen_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/elyvaen_surface_container_highest</item>
    </style>

    <style name="Theme.Booming.FollowSystem" parent="Base.Theme.Booming.Adaptive"/>

    <style name="Theme.Booming.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/boomingmusic_logo_splash</item>
    </style>

    <style name="Theme.Booming.AudioPreview" parent="Theme.Booming.FollowSystem">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.Booming.AppWidget.Preview.Control" parent="">
        <item name="android:scaleType">center</item>
        <item name="android:background">@drawable/widget_shape_button</item>
        <item name="android:backgroundTint">?attr/colorTertiary</item>
        <item name="android:tint">?attr/colorOnTertiary</item>
    </style>


    <style name="Widget.Booming.AppWidget.Preview.Accent" parent="Widget.Booming.AppWidget.Preview.Control">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:tint">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.Booming.Expressive.Button" parent="Widget.Material3Expressive.Button">
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Booming.Expressive.Button.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="iconGravity">textStart</item>
    </style>

    <style name="PlayerIconButton" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="iconGravity">textStart</item>
        <item name="iconTint">?colorOnSurface</item>
        <item name="rippleColor">?colorControlHighlight</item>
    </style>

    <style name="PlayerIconButton.Medium">
        <item name="iconSize">32dp</item>
    </style>

    <style name="PlayerIconButton.Large">
        <item name="iconSize">64dp</item>
    </style>

    <style name="SearchChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="android:checked">false</item>
        <item name="android:textSize">16sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipEndPadding">10dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipStartPadding">10dp</item>
    </style>

    <style name="MenuButtonStyle" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:focusable">false</item>
        <item name="icon">@drawable/ic_more_vert_24dp</item>
    </style>

    <style name="Widget.Booming.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Booming.BottomNavigation.ActiveIndicator</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Booming.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/elyvaen_primary_container</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="android:maxWidth">@null</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerMedium</item>
    </style>

    <style name="ModalBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?colorSurfaceContainer</item>
        <item name="shapeAppearance">?shapeAppearanceCornerLarge</item>
    </style>

    <style name="ModalBottomSheetStyle.EdgeToEdge">
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="CircularShapeAppearance" parent="">
        <item name="cornerSize">50%</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="ShapeAppearanceOverlay.Elyvaen.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="TextAppearance.Elyvaen.LibraryTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Base.SquigglySlider" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTint">?colorPrimary</item>
        <item name="android:thumbTint">?colorPrimary</item>
        <item name="android:progressBackgroundTint">?android:attr/textColorTertiary</item>
        <item name="android:clickable">true</item>
        <item name="android:splitTrack">false</item>
        <item name="android:thumb">@drawable/squiggly_thumb</item>
    </style>

    <style name="SquigglySlider" parent="Base.SquigglySlider">
        <item name="android:progressDrawable">@drawable/media_squiggly_progress</item>
    </style>

</resources>
