From 21036cc3f38474f58c2bfa25a7aee1df987d98c4 Mon Sep 17 00:00:00 2001
From: Elyvaen <elyvaen@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:47:35 +0000
Subject: [PATCH] uac2: add host volume and mute controls

---
 drivers/usb/gadget/function/f_uac2.c  | 134 ++++++++++++++++++++++----
 drivers/usb/gadget/function/u_audio.c |  78 ++++++++++++++-
 drivers/usb/gadget/function/u_audio.h |   3 +
 3 files changed, 197 insertions(+), 18 deletions(-)

diff --git a/drivers/usb/gadget/function/f_uac2.c b/drivers/usb/gadget/function/f_uac2.c
index 64a7785b9..68637c0bd 100644
--- a/drivers/usb/gadget/function/f_uac2.c
+++ b/drivers/usb/gadget/function/f_uac2.c
@@ -217,6 +217,23 @@ static struct uac2_output_terminal_descriptor io_out_ot_desc = {
 	.bmControls = cpu_to_le16(CONTROL_RDWR << COPY_CTRL),
 };
 
+struct uac2_fu_desc_2ch {
+	__u8 bLength;
+	__u8 bDescriptorType;
+	__u8 bDescriptorSubtype;
+	__u8 bUnitID;
+	__u8 bSourceID;
+	__u8 bmaControls[12];
+	__u8 iFeature;
+} __packed;
+
+static struct uac2_fu_desc_2ch fu_desc = {
+	.bLength = 18,
+	.bDescriptorType = USB_DT_CS_INTERFACE,
+	.bDescriptorSubtype = UAC_FEATURE_UNIT,
+	.bmaControls = { 3, 0, 0, 0, 3, 0, 0, 0, 3, 0, 0, 0 },
+};
+
 static struct uac2_ac_header_descriptor ac_hdr_desc = {
 	.bLength = sizeof ac_hdr_desc,
 	.bDescriptorType = USB_DT_CS_INTERFACE,
@@ -404,6 +421,7 @@ static struct usb_descriptor_header *fs_audio_desc[] = {
 	(struct usb_descriptor_header *)&in_clk_src_desc,
 	(struct usb_descriptor_header *)&out_clk_src_desc,
 	(struct usb_descriptor_header *)&usb_out_it_desc,
+	(struct usb_descriptor_header *)&fu_desc,
 	(struct usb_descriptor_header *)&io_in_it_desc,
 	(struct usb_descriptor_header *)&usb_in_ot_desc,
 	(struct usb_descriptor_header *)&io_out_ot_desc,
@@ -434,6 +452,7 @@ static struct usb_descriptor_header *hs_audio_desc[] = {
 	(struct usb_descriptor_header *)&in_clk_src_desc,
 	(struct usb_descriptor_header *)&out_clk_src_desc,
 	(struct usb_descriptor_header *)&usb_out_it_desc,
+	(struct usb_descriptor_header *)&fu_desc,
 	(struct usb_descriptor_header *)&io_in_it_desc,
 	(struct usb_descriptor_header *)&usb_in_ot_desc,
 	(struct usb_descriptor_header *)&io_out_ot_desc,
@@ -464,6 +483,7 @@ static struct usb_descriptor_header *ss_audio_desc[] = {
 	(struct usb_descriptor_header *)&in_clk_src_desc,
 	(struct usb_descriptor_header *)&out_clk_src_desc,
 	(struct usb_descriptor_header *)&usb_out_it_desc,
+	(struct usb_descriptor_header *)&fu_desc,
 	(struct usb_descriptor_header *)&io_in_it_desc,
 	(struct usb_descriptor_header *)&usb_in_ot_desc,
 	(struct usb_descriptor_header *)&io_out_ot_desc,
@@ -499,6 +519,17 @@ struct cntrl_range_lay3 {
 	__le32	dRES;
 } __packed;
 
+struct cntrl_cur_lay2 {
+	__le16	wCUR;
+} __packed;
+
+struct cntrl_range_lay2 {
+	__le16	wNumSubRanges;
+	__le16	wMIN;
+	__le16	wMAX;
+	__le16	wRES;
+} __packed;
+
 static int set_ep_max_packet_size(const struct f_uac2_opts *uac2_opts,
 	struct usb_endpoint_descriptor *ep_desc,
 	enum usb_device_speed speed, bool is_playback)
@@ -548,8 +579,10 @@ static void setup_descriptor(struct f_uac2_opts *opts)
 	/* patch descriptors */
 	int i = 1; /* ID's start with 1 */
 
-	if (EPOUT_EN(opts))
+	if (EPOUT_EN(opts)) {
 		usb_out_it_desc.bTerminalID = i++;
+		fu_desc.bUnitID = i++;
+	}
 	if (EPIN_EN(opts))
 		io_in_it_desc.bTerminalID = i++;
 	if (EPOUT_EN(opts))
@@ -566,7 +599,8 @@ static void setup_descriptor(struct f_uac2_opts *opts)
 	usb_in_ot_desc.bCSourceID = in_clk_src_desc.bClockID;
 	io_in_it_desc.bCSourceID = in_clk_src_desc.bClockID;
 	io_out_ot_desc.bCSourceID = out_clk_src_desc.bClockID;
-	io_out_ot_desc.bSourceID = usb_out_it_desc.bTerminalID;
+	fu_desc.bSourceID = usb_out_it_desc.bTerminalID;
+	io_out_ot_desc.bSourceID = fu_desc.bUnitID;
 	as_out_hdr_desc.bTerminalLink = usb_out_it_desc.bTerminalID;
 	as_in_hdr_desc.bTerminalLink = usb_in_ot_desc.bTerminalID;
 
@@ -587,6 +621,7 @@ static void setup_descriptor(struct f_uac2_opts *opts)
 
 		len += sizeof(out_clk_src_desc);
 		len += sizeof(usb_out_it_desc);
+		len += sizeof(fu_desc);
 		len += sizeof(io_out_ot_desc);
 		ac_hdr_desc.wTotalLength = cpu_to_le16(len);
 		iad_desc.bInterfaceCount++;
@@ -880,6 +915,8 @@ afunc_bind(struct usb_configuration *cfg, struct usb_function *fn)
 	agdev->params.c_srate = uac2_opts->c_srate;
 	agdev->params.c_ssize = uac2_opts->c_ssize;
 	agdev->params.req_number = uac2_opts->req_number;
+	agdev->params.host_volume = 0;
+	agdev->params.host_mute = 0;
 	ret = g_audio_setup(agdev, "UAC2 PCM", "UAC2_Gadget");
 	if (ret)
 		goto err_free_descs;
@@ -986,6 +1023,19 @@ in_rq_cur(struct usb_function *fn, const struct usb_ctrlrequest *cr)
 	p_srate = opts->p_srate;
 	c_srate = opts->c_srate;
 
+	if (entity_id == fu_desc.bUnitID) {
+		if (control_selector == UAC_FU_MUTE) {
+			u8 mute = agdev->params.host_mute ? 1 : 0;
+			value = min_t(unsigned, w_length, 1);
+			memcpy(req->buf, &mute, value);
+		} else if (control_selector == UAC_FU_VOLUME) {
+			__le16 vol = cpu_to_le16((__u16)(s16)agdev->params.host_volume);
+			value = min_t(unsigned, w_length, sizeof(vol));
+			memcpy(req->buf, &vol, value);
+		}
+		return value;
+	}
+
 	if (control_selector == UAC2_CS_CONTROL_SAM_FREQ) {
 		struct cntrl_cur_lay3 c;
 		memset(&c, 0, sizeof(struct cntrl_cur_lay3));
@@ -1024,6 +1074,22 @@ in_rq_range(struct usb_function *fn, const struct usb_ctrlrequest *cr)
 	int value = -EOPNOTSUPP;
 	int i;
 
+	if (entity_id == fu_desc.bUnitID) {
+		if (control_selector != UAC_FU_VOLUME)
+			return -EOPNOTSUPP;
+		{
+			struct cntrl_range_lay2 r;
+			memset(&r, 0, sizeof(r));
+			r.wNumSubRanges = cpu_to_le16(1);
+			r.wMIN = cpu_to_le16((__u16)(s16)-32512);
+			r.wMAX = cpu_to_le16(0);
+			r.wRES = cpu_to_le16(1);
+			value = min_t(unsigned, w_length, sizeof(r));
+			memcpy(req->buf, &r, value);
+		}
+		return value;
+	}
+
 	if (control_selector != UAC2_CS_CONTROL_SAM_FREQ)
 		return -EOPNOTSUPP;
 	if (entity_id != USB_IN_CLK_ID && entity_id != USB_OUT_CLK_ID)
@@ -1057,6 +1123,7 @@ ac_rq_in(struct usb_function *fn, const struct usb_ctrlrequest *cr)
 
 static struct f_uac2 *uac2_rate_pending;
 static u8 uac2_rate_entity;
+static u8 uac2_rate_selector;
 static void (*uac2_rate_orig_complete)(struct usb_ep *ep, struct usb_request *req);
 
 static bool uac2_rate_valid(u32 rate)
@@ -1077,21 +1144,41 @@ static void uac2_rate_complete(struct usb_ep *ep, struct usb_request *req)
 	uac2_rate_pending = NULL;
 	uac2_rate_orig_complete = NULL;
 
-	if (uac2 && req->status == 0 && req->actual >= sizeof(__le32)) {
-		__le32 raw;
-		u32 rate;
+	if (uac2 && req->status == 0) {
 		struct g_audio *agdev = &uac2->g_audio;
 		struct f_uac2_opts *opts = g_audio_to_uac2_opts(agdev);
 
-		memcpy(&raw, req->buf, sizeof(raw));
-		rate = le32_to_cpu(raw);
-		if (uac2_rate_valid(rate)) {
-			if (uac2_rate_entity == USB_OUT_CLK_ID) {
-				agdev->params.c_srate = rate;
-				opts->c_srate = rate;
-			} else if (uac2_rate_entity == USB_IN_CLK_ID) {
-				agdev->params.p_srate = rate;
-				opts->p_srate = rate;
+		if (uac2_rate_entity == fu_desc.bUnitID &&
+		    uac2_rate_selector == UAC_FU_MUTE && req->actual >= 1) {
+			agdev->params.host_mute = ((u8 *)req->buf)[0] ? 1 : 0;
+		} else if (uac2_rate_entity == fu_desc.bUnitID &&
+			   uac2_rate_selector == UAC_FU_VOLUME &&
+			   req->actual >= sizeof(__le16)) {
+			__le16 raw;
+			s16 vol;
+
+			memcpy(&raw, req->buf, sizeof(raw));
+			vol = (s16)le16_to_cpu(raw);
+			if (vol < -32512)
+				vol = -32512;
+			if (vol > 0)
+				vol = 0;
+			agdev->params.host_volume = vol;
+		} else if (uac2_rate_selector == UAC2_CS_CONTROL_SAM_FREQ &&
+		    req->actual >= sizeof(__le32)) {
+			__le32 raw;
+			u32 rate;
+
+			memcpy(&raw, req->buf, sizeof(raw));
+			rate = le32_to_cpu(raw);
+			if (uac2_rate_valid(rate)) {
+				if (uac2_rate_entity == USB_OUT_CLK_ID) {
+					agdev->params.c_srate = rate;
+					opts->c_srate = rate;
+				} else if (uac2_rate_entity == USB_IN_CLK_ID) {
+					agdev->params.p_srate = rate;
+					opts->p_srate = rate;
+				}
 			}
 		}
 	}
@@ -1113,13 +1200,26 @@ out_rq_cur(struct usb_function *fn, const struct usb_ctrlrequest *cr)
 	u8 entity_id = (w_index >> 8) & 0xff;
 	u8 control_selector = w_value >> 8;
 
-	if (control_selector != UAC2_CS_CONTROL_SAM_FREQ)
-		return -EOPNOTSUPP;
-	if (w_length < sizeof(__le32))
+	if (entity_id == fu_desc.bUnitID &&
+	    control_selector == UAC_FU_MUTE) {
+		if (w_length < 1)
+			return -EOPNOTSUPP;
+	} else if (entity_id == fu_desc.bUnitID &&
+		   control_selector == UAC_FU_VOLUME) {
+		if (w_length < sizeof(__le16))
+			return -EOPNOTSUPP;
+	} else if (control_selector == UAC2_CS_CONTROL_SAM_FREQ) {
+		if (entity_id != USB_IN_CLK_ID && entity_id != USB_OUT_CLK_ID)
+			return -EOPNOTSUPP;
+		if (w_length < sizeof(__le32))
+			return -EOPNOTSUPP;
+	} else {
 		return -EOPNOTSUPP;
+	}
 
 	uac2_rate_pending = uac2;
 	uac2_rate_entity = entity_id;
+	uac2_rate_selector = control_selector;
 	uac2_rate_orig_complete = req->complete;
 	req->complete = uac2_rate_complete;
 	return w_length;
diff --git a/drivers/usb/gadget/function/u_audio.c b/drivers/usb/gadget/function/u_audio.c
index f1c69cecd..6118bd895 100644
--- a/drivers/usb/gadget/function/u_audio.c
+++ b/drivers/usb/gadget/function/u_audio.c
@@ -528,6 +528,62 @@ static const struct snd_kcontrol_new uac_capture_rate_ctl = {
 	.get = uac_capture_rate_get,
 };
 
+static int uac_host_volume_info(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = -32512;
+	uinfo->value.integer.max = 0;
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int uac_host_volume_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_uac_chip *uac = snd_kcontrol_chip(kcontrol);
+
+	ucontrol->value.integer.value[0] = uac->audio_dev->params.host_volume;
+	return 0;
+}
+
+static const struct snd_kcontrol_new uac_host_volume_ctl = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.name = "UAC2 Host Volume",
+	.access = SNDRV_CTL_ELEM_ACCESS_READ,
+	.info = uac_host_volume_info,
+	.get = uac_host_volume_get,
+};
+
+static int uac_host_mute_info(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_BOOLEAN;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 1;
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int uac_host_mute_get(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_uac_chip *uac = snd_kcontrol_chip(kcontrol);
+
+	ucontrol->value.integer.value[0] = uac->audio_dev->params.host_mute;
+	return 0;
+}
+
+static const struct snd_kcontrol_new uac_host_mute_ctl = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.name = "UAC2 Host Mute",
+	.access = SNDRV_CTL_ELEM_ACCESS_READ,
+	.info = uac_host_mute_info,
+	.get = uac_host_mute_get,
+};
+
 int g_audio_setup(struct g_audio *g_audio, const char *pcm_name,
 					const char *card_name)
 {
@@ -624,7 +680,27 @@ int g_audio_setup(struct g_audio *g_audio, const char *pcm_name,
 	sprintf(card->longname, "%s %i", card_name, card->dev->id);
 
 	{
-		struct snd_kcontrol *kctl = snd_ctl_new1(&uac_capture_rate_ctl, uac);
+		struct snd_kcontrol *kctl;
+
+		kctl = snd_ctl_new1(&uac_capture_rate_ctl, uac);
+		if (!kctl) {
+			err = -ENOMEM;
+			goto snd_fail;
+		}
+		err = snd_ctl_add(card, kctl);
+		if (err < 0)
+			goto snd_fail;
+
+		kctl = snd_ctl_new1(&uac_host_volume_ctl, uac);
+		if (!kctl) {
+			err = -ENOMEM;
+			goto snd_fail;
+		}
+		err = snd_ctl_add(card, kctl);
+		if (err < 0)
+			goto snd_fail;
+
+		kctl = snd_ctl_new1(&uac_host_mute_ctl, uac);
 		if (!kctl) {
 			err = -ENOMEM;
 			goto snd_fail;
diff --git a/drivers/usb/gadget/function/u_audio.h b/drivers/usb/gadget/function/u_audio.h
index 81d3d4ed6..8e53ee5cc 100644
--- a/drivers/usb/gadget/function/u_audio.h
+++ b/drivers/usb/gadget/function/u_audio.h
@@ -22,6 +22,9 @@ struct uac_params {
 	int c_srate;	/* rate in Hz */
 	int c_ssize;	/* sample size */
 
+	int host_volume; /* UAC2 host volume, 1/256 dB */
+	int host_mute;   /* UAC2 host mute */
+
 	int req_number; /* number of preallocated requests */
 };
 
-- 
2.54.0

