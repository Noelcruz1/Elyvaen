(allow hal_audio_default shell_data_file (dir (search getattr add_name write)))
(allow hal_audio_default shell_data_file (fifo_file (create open read write getattr ioctl setattr)))
(allow system_app shell_data_file (dir (search getattr)))
(allow system_app shell_data_file (fifo_file (open read getattr ioctl)))
(allow hal_audio_default hal_audio_default (capability (dac_override)))
(allow priv_app shell_data_file (dir (search getattr)))
(allow priv_app shell_data_file (fifo_file (open read getattr ioctl)))
(allow hal_audio_default shell_data_file (file (create open read write getattr)))
(allow priv_app shell_data_file (file (open read getattr)))
